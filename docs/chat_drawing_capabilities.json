{
  "version": 1,
  "default_entry": "glyph-arts chat",
  "skill_package": "skills/chat-drawing",
  "verification_script": "skills/chat-drawing/scripts/verify_chat_art.py",
  "closed_loop": [
    "route",
    "render",
    "verify",
    "rerender_on_failure",
    "reply_with_stdout"
  ],
  "capabilities": {
    "image_ascii": {
      "chat": true,
      "ansi": true,
      "artifact": true,
      "command": "glyph-arts chat image --file <path>",
      "protocol": {
        "targets": [
          "chat",
          "terminal",
          "artifact"
        ],
        "chat_safe": true,
        "uses_ansi": false,
        "unicode_tier": "unicode",
        "fallback": "ascii",
        "requires_host": "none"
      }
    },
